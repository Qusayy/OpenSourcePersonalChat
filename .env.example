# Copy to .env and adjust. All settings are optional; defaults target a 2 vCPU / 4 GB VPS.

# --- gate ---
# Who is let past the cover (app/gate.py). The site is sealed until a verifier
# is set below: a visitor is shown a night sky and nothing opens it. "off"
# serves the whole site to anyone who can reach it. It is for local
# development only, on a machine nobody else can reach, never for a server.
# AURORA_GATE=off
# On a server: set the pattern instead. Make the line on a development machine
# (cd web && npm run dev, then /setup.html) and put it here, in the server's
# own copy of this file and nowhere else. Whoever has it can work the pattern
# out.
# AURORA_GATE_VERIFIER=gate1.300000.<salt>.<hash>
# A session ends when the browser closes. These end it anyway.
# AURORA_GATE_SESSION_HOURS=12
# AURORA_GATE_IDLE_MINUTES=60
# Once the site is served over https: refuse the pattern over plain http,
# unless it comes from this machine itself.
# AURORA_GATE_HTTPS_ONLY=true
# With the gate off, other names the site answers to besides localhost,
# comma-separated (a LAN name, say). Any other name is refused.
# AURORA_ALLOWED_HOSTS=
# How long a change the agent wants to make after reading the web waits for
# you to allow it, in seconds, before it counts as no.
# AURORA_CONFIRM_SECONDS=600

# --- model ---
AURORA_MODEL_PATH=./models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
AURORA_MODEL_LABEL=Qwen2.5-1.5B-Instruct
AURORA_MODEL_QUANT=Q4_K_M
AURORA_MODEL_PARAMS=1.5B

# --- llama.cpp runtime ---
# Unset: the model is loaded into the app with llama-cpp-python. Set: every pass
# goes to the llama-server there instead (deploy/aurora-llm.service, which reads
# this same file for the model path, threads and context). Removing the line
# and restarting the app puts the model back in the app.
# AURORA_LLM_URL=http://127.0.0.1:8081
# A key the model server asks every request for, so that no other process on
# the machine can use it. Put the same key alone on a line in a file only
# aurora can read, and hand the server that file (not the key itself, which
# anyone on the machine could read off its command line):
#   AURORA_LLM_ARGS=--api-key-file /srv/aurora/llm.key
# AURORA_LLM_KEY=<a long random string, e.g. from: openssl rand -hex 32>
AURORA_N_CTX=16384
# 0 = every CPU the service may use, measured at startup; a number pins it
AURORA_N_THREADS=0
AURORA_N_BATCH=256
AURORA_USE_MMAP=true
# needs LimitMEMLOCK=infinity in the systemd unit; leave false on dev machines
AURORA_USE_MLOCK=false
# "auto" uses the chat template baked into the GGUF; "chatml" forces Qwen's format
AURORA_CHAT_FORMAT=auto

# Qwen3.5-4B in llama-server, thinking before it answers. The app writes the
# whole prompt itself, every answer as the model wrote it, thinking included, so
# each message begins with the last and the server's cache of the conversation
# holds. A reply thinks for at most AURORA_THINK_BUDGET tokens.
# AURORA_MODEL_PATH=./models/Qwen3.5-4B-Q4_K_M.gguf
# AURORA_MODEL_LABEL=Qwen3.5-4B
# AURORA_MODEL_QUANT=Q4_K_M
# AURORA_MODEL_PARAMS=4B
# AURORA_LLM_URL=http://127.0.0.1:8081
# AURORA_N_CTX=16384
# AURORA_KV_KIB_PER_TOKEN=32
# AURORA_THINKING=on
# AURORA_THINK_BUDGET=1024

# --- tools ---
AURORA_TOOLS_ENABLED=true
# false removes every network tool from the registry, the menu and the UI
AURORA_ALLOW_OUTBOUND=true
AURORA_TOOL_TIMEOUT=10
# Wikimedia returns 403 for a User-Agent with no contact details — point this
# at your own repository or email before using the Wikipedia tool.
AURORA_USER_AGENT=Aurora/2.0 (+https://github.com/you/aurora; self-hosted llama.cpp chat)
# Searching the web, with no key. auto: the SearXNG below where it is set,
# DuckDuckGo's HTML page where not. searxng | duckduckgo name one; off takes
# the search off the menu.
AURORA_SEARCH=auto
# This server's own SearXNG, on loopback (deploy/build-searxng.sh).
# AURORA_SEARX_URL=http://127.0.0.1:8888
# The Google News edition the headlines are from, COUNTRY:language.
AURORA_NEWS_REGION=US:en
# Python the model writes, run under bubblewrap (deploy/build-sandbox.sh). auto:
# wherever the sandbox can run; off: never. Nothing runs outside it.
AURORA_SANDBOX=auto
# The zone the model is told each message was sent in, so "today" and
# "latest" mean the date they mean. An IANA name: Europe/London, Asia/Amman.
AURORA_TIMEZONE=UTC
# Let the model call a tool, read what came back and call another before it
# answers. Each call costs a reply of the model (seconds). false: at most one
# call, then the answer.
AURORA_AGENT_LOOP=true
# its limits for one message: tool calls, and seconds after which no further
# call is begun
AURORA_AGENT_MAX_STEPS=8
AURORA_AGENT_MAX_SECONDS=600
# Notes the Agent keeps when asked to remember something. "conversation": a
# note belongs to its conversation and is deleted with it. "site": every
# conversation shares them; only for a private deployment, since the site has
# no accounts. "off": no notes.
AURORA_NOTES=conversation

# --- app ---
AURORA_HOST=127.0.0.1
AURORA_PORT=8000
AURORA_DB_PATH=./data/aurora.db
# How pages name the machine in prose ("running on a …"). Leave it unset and
# the machine is described from what is measured (CPUs it can use, total RAM).
# The status line always shows measured figures, whatever this says.
# AURORA_HARDWARE_LABEL=2 vCPU · 4 GB VPS
# Days to keep the step-by-step record of each message (tool, arguments,
# result, tokens and time per pass). It copies what visitors typed. 0 keeps none.
AURORA_STEPS_KEEP_DAYS=30

# Fake generator: run the whole site with no GGUF present (UI development).
AURORA_MOCK=false
# seconds between fake tokens in mock mode (0 = as fast as possible)
AURORA_MOCK_DELAY=0.085
