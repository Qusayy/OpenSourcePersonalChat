[Unit]
Description=Aurora — the model server (ik_llama.cpp llama-server)
# Used only when the app's .env sets AURORA_LLM_URL=http://127.0.0.1:8081.
# Without that line the app loads the model itself and this can stay off.
After=network.target

[Service]
Type=simple
User=aurora
Group=aurora
WorkingDirectory=/srv/aurora

# The app's own .env, so the model, the threads and the context are read from
# the lines the app reads and the two can never disagree. These defaults are
# the app's, for a .env that leaves a line out; the file overrides them.
Environment=AURORA_MODEL_PATH=./models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
Environment=AURORA_N_THREADS=0
Environment=AURORA_N_CTX=16384
# Anything else this model needs, word by word, from the .env. The app writes
# every prompt itself and sends it to /completion, so the server's chat
# template is not used by it. With AURORA_LLM_KEY set, the same key goes in
# here as a file, --api-key-file /srv/aurora/llm.key (mode 0600, owned by
# aurora), and never as --api-key, which every user can read in `ps`.
Environment=AURORA_LLM_ARGS=
EnvironmentFile=/srv/aurora/.env

# Built by deploy/build-llama-server.sh.
#   -t 0     every CPU, as AURORA_N_THREADS=0 means in the app
#   -np 1    one slot: the app runs one pass at a time and keeps the queue
#   -rtr     repack the weights for this CPU as they load; on the measured
#            server most of the gain over the app's own llama.cpp is this
#   --mlock  keep them in RAM (needs the LimitMEMLOCK below)
# Loopback only, on a port nginx never proxies.
ExecStart=/opt/aurora-llm/bin/llama-server \
    -m ${AURORA_MODEL_PATH} -t ${AURORA_N_THREADS} -c ${AURORA_N_CTX} \
    -np 1 --host 127.0.0.1 --port 8081 -rtr --mlock $AURORA_LLM_ARGS

LimitMEMLOCK=infinity

# OOM guard: kill and restart rather than dragging the whole VPS down. The
# app waits for the server to come back and says so on the page meanwhile.
# Qwen3.5-4B at Q4_K_M is 2.7 GB of weights, 0.5 GB of cache at 16k, and
# its working buffers: about 3.7 GB.
MemoryMax=4500M
MemoryHigh=4200M

Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
