[Unit]
Description=Aurora — local LLM web front-end
After=network-online.target
Wants=network-online.target
# With AURORA_LLM_URL set the model is in aurora-llm.service, enabled on its
# own. When both start, that one starts first; the app waits for its model
# either way. It is not pulled in from here, so with the line unset and that
# service disabled nothing loads the weights twice.
After=aurora-llm.service

[Service]
Type=simple
User=aurora
Group=aurora
WorkingDirectory=/srv/aurora
Environment="PATH=/srv/aurora/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/srv/aurora/.env

# One worker. The model is a single in-process object; a second worker would
# load a second copy of the weights and put the box straight into swap. With
# the model in aurora-llm.service it is still one: the one slot and the queue
# live in this process, and a second would send the server work behind its back.
ExecStart=/srv/aurora/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --timeout-keep-alive 75

# Required when AURORA_USE_MLOCK=true — without it llama.cpp cannot pin the
# weights and silently falls back to pageable memory.
LimitMEMLOCK=infinity

# OOM guard: kill and restart rather than dragging the whole VPS down.
MemoryMax=3G
MemoryHigh=2600M
# A program in the Python sandbox runs in this unit's cgroup: this bounds a
# fork bomb to it, far above what the app's own threads need.
TasksMax=256

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
