{"id": "something-current-is-searched", "category": "single-tool", "turns": ["what is the latest version of python"], "tools": {"web_search": "web_search_python_release.json"}, "script": ["<tool_call>\n<function=web_search>\n<parameter=query>\nlatest version of python\n</parameter>\n</function>\n</tool_call>", "The latest is Python 3.14.0."], "expect": {"route": {"tool": "web_search", "via": "model"}, "calls": ["web_search"], "max_model_passes": 2, "prompt_contains": ["1. Python 3.14.0 is now available"]}}
{"id": "a-result-is-opened-by-its-number", "category": "two-step", "loop": true, "turns": ["look up what changed in python and read the release page"], "tools": {"web_search": "web_search_python_release.json", "open_result": "open_result_python_release.json"}, "script": ["<tool_call>\n<function=web_search>\n<parameter=query>\npython release notes\n</parameter>\n</function>\n</tool_call>", "<tool_call>\n<function=open_result>\n<parameter=number>\n1\n</parameter>\n</function>\n</tool_call>", "Python 3.14.0 adds free-threaded builds and template strings."], "expect": {"calls": ["web_search", "open_result"], "prompt_contains": ["free-threaded builds"]}}
